{
  "name": "thoock-desktop-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mac:dev": "node scripts/build-macos-dev.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "migration:pack": "cargo run --manifest-path src-tauri/Cargo.toml --bin migration-pack --",
    "check": "npm run build && npm run test && npm run test:rust",
    "format": "prettier --write src tests *.ts *.json docs/IMPLEMENTATION_STATUS.md README.md"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.2",
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.4"
  }
}
